{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Flask App",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"flask",
				"--app",
				"src.main",
				"run",
				"--debug"
			],
			"isBackground": true,
			"group": "build"
			},
			{
				"label": "Run Tests",
				"type": "shell",
				"command": "python",
				"args": [
					"-m",
					"pytest",
					"-q",
					"-p",
					"no:cacheprovider"
				],
				"group": "test"
		}
	]
}